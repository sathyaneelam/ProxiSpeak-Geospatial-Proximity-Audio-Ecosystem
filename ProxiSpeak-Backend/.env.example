# ==========================================
# ProxiSpeak Backend - Environment Variables
# ==========================================

# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection URI
# Local MongoDB (e.g., standard local development):
MONGODB_URI=mongodb://127.0.0.1:27017/proxispeak
# Or MongoDB Atlas replica set (replace username, password, cluster, and dbname):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/proxispeak?retryWrites=true&w=majority

# Virtual Office 2D Planar Audio Settings
# Audio proximity cutoff distance in screen pixels (default: 100px)
PROXIMITY_RADIUS_PIXELS=100

# Virtual Office Canvas Bounds
DEFAULT_OFFICE_WIDTH=1000
DEFAULT_OFFICE_HEIGHT=600
